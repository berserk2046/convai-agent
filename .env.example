# Copy to .env and fill in. Empty values count as unset.
# Outside production, DATABASE_URL and REDIS_URL default to the docker-compose services.

NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=

DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform
REDIS_URL=redis://127.0.0.1:6379

# LLM. Each template names its model (agent.model). The worker needs the key for the agent
# (INBOUND_HANDLER=agent) and for eval runs; the admin needs it for the playground; the CLI
# for live evals (pnpm template eval --live).
ANTHROPIC_API_KEY=
# Grades eval `judge` assertions (structured output). Must have a price in @platform/llm.
JUDGE_MODEL=claude-sonnet-5-5
# Monthly AI spend cap per business, unless the business has its own (principle 10).
LLM_BUDGET_USD_MONTH=15

# WhatsApp Cloud API (Meta)
# App secret: Meta App Dashboard → App settings → Basic. Signs every webhook.
META_APP_SECRET=
# Any long random string; paste the same value in the webhook setup in Meta's dashboard.
META_VERIFY_TOKEN=
# Graph API version, e.g. v24.0. Never hard-coded.
META_GRAPH_VERSION=

# HTTP server (apps/api). Use HOST=0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=3000

# Inbound pipeline: replies wait this long for more messages from the same person.
INBOUND_DEBOUNCE_MS=3000
# agent | echo | off. "agent" needs ANTHROPIC_API_KEY; "echo" is a test harness (refused
# when NODE_ENV=production); "off" stores messages without answering.
INBOUND_HANDLER=agent

# Automatic messages (M4)
# on | off. "on" creates and edits WhatsApp message templates at Meta. Keep it off until
# the platform owner approves submitting templates.
META_TEMPLATE_SUBMISSION=off
# Monthly cap on marketing messages per business, unless the business has its own.
MARKETING_MSGS_MONTH=500

# Security
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Admin sessions (ADR 0011): at least 32 characters; the same command as above works.
# Changing it logs everyone out.
SESSION_SECRET=

# The first platform owner: `pnpm admin:create-owner` reads OWNER_EMAIL, OWNER_NAME and
# OWNER_PASSWORD from the environment (see packages/services/src/cli/create-owner.ts).
# Don't keep them here.

# Privacy: days before message text is purged.
RETENTION_DAYS=180

# Optional
SENTRY_DSN=

# Google Calendar (M8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Evals (ADR 0015): how `pnpm template eval <path>` gets the model's answers. "replay" uses
# templates/<slug>/eval-recordings.json; "live" calls the API (costs money). Eval runs and
# the playground create scratch databases on the DATABASE_URL server: its role needs CREATEDB.
EVAL_LLM=replay

# pnpm dev:setup only (local test with Meta's test number; see docs/whatsapp-test-number.md)
WA_TEST_PHONE_NUMBER_ID=
WA_TEST_WABA_ID=
WA_TEST_DISPLAY_PHONE=
WA_TEST_ACCESS_TOKEN=
