{
  "name": "@platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "generate": "drizzle-kit generate",
    "new": "drizzle-kit generate --custom --name",
    "dev-setup": "node --env-file-if-exists=../../.env src/cli/dev-setup.ts"
  },
  "dependencies": {
    "@platform/shared": "workspace:*",
    "@platform/templates": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
