{
  "name": "agent-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:new": "pnpm --filter @platform/db new",
    "template": "node packages/templates/src/cli/main.ts",
    "dev:setup": "pnpm --filter @platform/db dev-setup",
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:worker": "pnpm --filter @platform/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
